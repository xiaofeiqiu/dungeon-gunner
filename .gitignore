# Unity 6 2D Project .gitignore

# =====================================
# Recommended ignores for Unity projects
# More details: https://github.com/github/gitignore/blob/main/Unity.gitignore
# =====================================

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
MemoryCaptures/

# Crash reports
sysinfo.txt

# Autogenerated VS/MD/IDE files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.pidb.meta
*.booproj
*.svd
*.pdb
*.mdb

# Rider project files
.idea/
*.sln.iml

# VS Code settings
.vscode/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
Thumbs.db

# Node (if using Yarn/Node for tooling)
node_modules/

# Unity Package Manager lock file
Packages/packages-lock.json

# Optional: ignore package cache (uncomment if desired)
#/[Pp]ackage[Cc]ache/

# Logs
*.log

# Backups
*.bak
*.backup
